<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.dev.suellen.dukemarket.javafx.controller.ScrProdutosController">
   <children>
      <AnchorPane prefHeight="304.0" prefWidth="600.0" style="-fx-background-color: black;">
         <children>
            <TableView fx:id="tblProduto" layoutX="-7.0" onMouseClicked="#tblProdutoOnMouseClicked" prefHeight="304.0" prefWidth="781.0">
              <columns>
                <TableColumn fx:id="tcoId" prefWidth="75.0" text="ID" />
                <TableColumn fx:id="tcoCodBarras" prefWidth="75.0" text="Cod.Barras" />
                  <TableColumn fx:id="tcoDescricao" prefWidth="266.0" text="Descrição" />
                  <TableColumn fx:id="tcoQtd" prefWidth="75.0" text="Qtd." />
                  <TableColumn fx:id="tcoValorCompra" prefWidth="75.0" text="\$ Compra" />
                  <TableColumn fx:id="tcoValorVenda" prefWidth="75.0" text="\$ Venda" />
                  <TableColumn fx:id="tcoDataCadastro" prefWidth="138.0" text="Data Cadastro" />
              </columns>
            </TableView>
         </children>
      </AnchorPane>
      <AnchorPane layoutY="303.0" prefHeight="234.0" prefWidth="570.0">
         <children>
            <Label layoutX="20.0" layoutY="26.0" text="ID" />
            <Label layoutX="227.0" layoutY="27.0" text="Cod.Barras" />
            <Label layoutX="19.0" layoutY="61.0" text="Descrição" />
            <Label layoutX="18.0" layoutY="98.0" text="Qtd." />
            <Label layoutX="227.0" layoutY="100.0" text="Valor Compra" />
            <Label layoutX="18.0" layoutY="138.0" text="Valor Venda" />
            <Label layoutX="17.0" layoutY="174.0" text="Data Cadastro" />
            <DatePicker fx:id="dtpDataCadastro" layoutX="104.0" layoutY="170.0" />
            <TextField fx:id="txtId" layoutX="104.0" layoutY="23.0" prefHeight="25.0" prefWidth="84.0" />
            <TextField fx:id="txtDescricao" layoutX="104.0" layoutY="58.0" prefHeight="25.0" prefWidth="349.0" />
            <TextField fx:id="txtCodBarras" layoutX="309.0" layoutY="23.0" prefHeight="25.0" prefWidth="143.0" />
            <TextField fx:id="txtQtd" layoutX="104.0" layoutY="96.0" prefHeight="25.0" prefWidth="65.0" />
            <TextField fx:id="txtValorCompra" layoutX="315.0" layoutY="96.0" prefHeight="25.0" prefWidth="137.0" />
            <TextField fx:id="txtValorVenda" layoutX="104.0" layoutY="134.0" prefHeight="25.0" prefWidth="150.0" />
         </children>
      </AnchorPane>
      <Button fx:id="btnNovo" layoutX="536.0" layoutY="408.0" mnemonicParsing="false" onAction="#btnNovoClick" prefHeight="25.0" prefWidth="208.0" text="Novo" />
      <Button fx:id="btnSalvar" layoutX="536.0" layoutY="442.0" mnemonicParsing="false" onAction="#btnSalvarClick" prefHeight="25.0" prefWidth="208.0" text="Salvar" />
      <Button fx:id="btnExcluir" layoutX="536.0" layoutY="476.0" mnemonicParsing="false" onAction="#btnExcluirClick" prefHeight="25.0" prefWidth="208.0" text="Excluir" />
   </children>
</AnchorPane>
